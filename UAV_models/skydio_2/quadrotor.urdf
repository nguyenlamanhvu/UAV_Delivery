<?xml version="1.0"?>
<!-- Mesh file and approximate numbers are from Abe Bachrach at Skydio.  -->
<robot name="quadrotor">
  <!--
  Axes are standard vehicle coordinates:
    +X - Pointing toward the nose (primary camera).
    +Y - Towards the left rotors.
    +Z - Towards the top of the vehicle..
  Origin:
    (0, 0, 0) in the center of the main quadrotor body.
  -->
  <link name="base_link">
    <inertial>
      <mass value="0.775"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.0025" iyz="0.0" izz="0.0035"/>
    </inertial>
    <visual>
      <origin rpy="1.570796 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://uav_models/skydio_2/skydio_2_1000_poly.gltf" scale=".00254"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size=".36 .4 .06"/>
      </geometry>
    </collision>
  </link>

  <link name="camera_pitch_link">
    <inertial>
      <mass value="0.005"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="camera_pitch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="camera_pitch_link"/>
    <origin xyz="0.18 0 -0.03" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="1.57079632679" effort="1.0" velocity="4.0"/>
    <dynamics damping="0.25" friction="0.0"/>
  </joint>

  <link name="camera_link">
    <inertial>
      <mass value="0.005"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.02 0.06"/>
      </geometry>
      <material name="camera_body_gray">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>

    <visual>
      <origin xyz="0.05 0 0" rpy="0 1.57079632679 0"/>
      <geometry>
        <cylinder radius="0.003" length="0.10"/>
      </geometry>
      <material name="camera_axis_z_blue">
        <color rgba="0.15 0.35 1.0 1.0"/>
      </material>
    </visual>

    <visual>
      <origin xyz="0 0 -0.04" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.0025" length="0.08"/>
      </geometry>
      <material name="camera_axis_y_green">
        <color rgba="0.1 0.85 0.2 1.0"/>
      </material>
    </visual>

    <visual>
      <origin xyz="0 -0.04 0" rpy="0 0 1.57079632679"/>
      <geometry>
        <cylinder radius="0.0025" length="0.08"/>
      </geometry>
      <material name="camera_axis_x_red">
        <color rgba="0.95 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_pitch_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
</robot>
