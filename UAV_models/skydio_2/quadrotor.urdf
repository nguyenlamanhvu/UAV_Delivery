<?xml version="1.0"?>
<!-- Mesh file and approximate numbers are from Abe Bachrach at Skydio.  -->
<robot name="quadrotor">
  <!--
  Axes are standard vehicle coordinates:
    +X - Pointing toward the nose (primary camera).
    +Y - Towards the left rotors.
    +Z - Towards the top of the vehicle..
  Origin:
    (0, 0, 0) in the center of the main quadrotor body.
  -->
  <link name="base_link">
    <inertial>
      <!-- Base mass is exactly 0.765. Origin shifted back by 2.3mm to balance the 10g camera at x=0.18 -->
      <mass value="0.765"/>
      <origin xyz="-0.0023 0 0"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.0025" iyz="0.0" izz="0.0035"/>
    </inertial>
    <visual>
      <origin rpy="1.570796 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://uav_models/skydio_2/skydio_2_1000_poly.gltf" scale=".00254"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size=".36 .4 .06"/>
      </geometry>
    </collision>
  </link>

  <link name="camera_pitch_link">
    <inertial>
      <mass value="0.005"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="camera_pitch_joint" type="revolute">
    <parent link="base_link"/>
    <child link="camera_pitch_link"/>
    <origin xyz="0.18 0 -0.03" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="1.57079632679" effort="1.0" velocity="4.0"/>
    <dynamics damping="0.25" friction="0.0"/>
  </joint>

  <link name="camera_link">
    <inertial>
      <mass value="0.005"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_pitch_link"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>
</robot>
