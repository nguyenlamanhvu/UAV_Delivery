<?xml version="1.0"?>
<sdf version="1.7">
  <model name="campus">
    <static>true</static>
    <link name="campus_link">
      <!-- Shifts the model by its calculated center (scaled by 1000) to place it at the world origin -->
      <pose>-32.45 -24.75 -52.46 0 0 0</pose>
      <visual name="campus_visual">
        <geometry>
          <mesh>
            <uri>../UAV_models/env/scene.gltf</uri>
            <!-- Reverted to 1 1 1 to fit inside Meshcat's camera limits -->
            <scale>1000 1000 1000</scale>
          </mesh>
        </geometry>
      </visual>
      <!-- We can also use it for collision, though it might be slow for a very complex model -->
      <collision name="campus_collision">
        <geometry>
          <mesh>
            <uri>campus_model.obj</uri>
            <scale>1000 1000 1000</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
