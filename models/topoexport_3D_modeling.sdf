<?xml version="1.0"?>
<sdf version="1.7">
  <model name="topoexport_background">
    <static>true</static>
    <link name="topoexport_link">
      <!-- Center the topoexport model around the origin and place its base on z=0. -->
      <pose>-358.092906 -376.616608 -4.138078 0 0 0</pose>
      <visual name="topoexport_visual">
        <geometry>
          <mesh>
            <uri>topoexport_3D_modeling.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>0.15 0.15 0.15 1.0</specular>
          <emissive>0.7 0.7 0.7 1.0</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
